# Authenticated machine ingestion. Current gateway can receive a trusted channel;
# native device ability to send Authorization must be verified before direct use.
NODE_ENV=production
PORT=8080
BIOMETRIC_RAILWAY_MODE=database-ingest
BIOMETRIC_INGEST_HOST=0.0.0.0
BIOMETRIC_INGEST_TOKEN=
BIOMETRIC_INGEST_ALLOWED_DEVICES=
BIOMETRIC_INGEST_AUTO_FINALIZE_NEW_PUNCHES=false
BIOMETRIC_INGEST_DB_HOST=
BIOMETRIC_INGEST_DB_PORT=4000
BIOMETRIC_INGEST_DB_USER=
BIOMETRIC_INGEST_DB_PASSWORD=
BIOMETRIC_INGEST_DB_NAME=fingerprint
BIOMETRIC_INGEST_DB_CONFIRMED_NAME=fingerprint
BIOMETRIC_INGEST_DB_SSL_MODE=required
BIOMETRIC_INGEST_DB_CONNECT_TIMEOUT_MS=6000
BIOMETRIC_INGEST_DB_QUERY_TIMEOUT_MS=5000
BIOMETRIC_INGEST_DB_TRANSACTION_TIMEOUT_MS=15000
BIOMETRIC_PORTAL_ORIGIN=https://fingerprint-production-c9df.up.railway.app
BIOMETRIC_PORTAL_ADMIN_USERNAME=admin
BIOMETRIC_PORTAL_ADMIN_PASSWORD_HASH=
