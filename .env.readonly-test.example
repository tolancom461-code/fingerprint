# Isolated database-reader runtime only. Do not copy production credentials here.
# Start explicitly: node --env-file=.env.readonly-test src/test-portal.js
PORT=8081
BIOMETRIC_READ_PORTAL_HOST=127.0.0.1
BIOMETRIC_READ_PORTAL_ORIGIN=http://127.0.0.1:8081
BIOMETRIC_READ_PORTAL_ADMIN_USERNAME=test-admin
BIOMETRIC_READ_PORTAL_ADMIN_PASSWORD_HASH=
# Optional viewer: configure both values together.
BIOMETRIC_READ_PORTAL_VIEWER_USERNAME=
BIOMETRIC_READ_PORTAL_VIEWER_PASSWORD_HASH=

BIOMETRIC_TEST_DB_HOST=127.0.0.1
BIOMETRIC_TEST_DB_PORT=3306
BIOMETRIC_TEST_DB_USER=
BIOMETRIC_TEST_DB_PASSWORD=
BIOMETRIC_TEST_DB_NAME=biometric_portal_test_example
# The separately confirmed cloud test database may instead use:
# BIOMETRIC_TEST_DB_NAME=fingerprint
# BIOMETRIC_TEST_DB_CONFIRMED_NAME=fingerprint
# Must match the dedicated test identity table. Generate your own UUID v4.
BIOMETRIC_TEST_DB_INSTANCE_ID=
# disabled is accepted only for loopback. Use required for a remote test database.
BIOMETRIC_TEST_DB_SSL_MODE=disabled
BIOMETRIC_TEST_DB_CONNECT_TIMEOUT_MS=4000
BIOMETRIC_TEST_DB_QUERY_TIMEOUT_MS=5000
