# Real cloned database, SELECT-only portal. No fixture identity is used.
# node --env-file=.env.portal-database src/portal-database.js
PORT=8080
BIOMETRIC_PORTAL_HOST=0.0.0.0
BIOMETRIC_PORTAL_ORIGIN=https://fingerprint-production-c9df.up.railway.app
BIOMETRIC_PORTAL_ADMIN_USERNAME=admin
# Generate locally with npm run admin:password-hash; never store a plain password.
BIOMETRIC_PORTAL_ADMIN_PASSWORD_HASH=
# Optional viewer: both values must be configured together.
BIOMETRIC_PORTAL_VIEWER_USERNAME=
BIOMETRIC_PORTAL_VIEWER_PASSWORD_HASH=
BIOMETRIC_PORTAL_DB_HOST=
BIOMETRIC_PORTAL_DB_PORT=4000
BIOMETRIC_PORTAL_DB_USER=
BIOMETRIC_PORTAL_DB_PASSWORD=
BIOMETRIC_PORTAL_DB_NAME=fingerprint
BIOMETRIC_PORTAL_DB_CONFIRMED_NAME=fingerprint
BIOMETRIC_PORTAL_DB_SSL_MODE=required
BIOMETRIC_PORTAL_DB_CONNECT_TIMEOUT_MS=6000
BIOMETRIC_PORTAL_DB_QUERY_TIMEOUT_MS=5000
# Explicit opt-in for src/railway.js; without it the image keeps the demo runtime.
BIOMETRIC_RAILWAY_MODE=database-readonly
