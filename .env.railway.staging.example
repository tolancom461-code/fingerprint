# Public staging template: contains no credentials and does not enable real devices.
# Railway imports variables into the process; it does not need this file in the image.
NODE_ENV=production
PORT=8080

# Optional parent directory; the launcher always adds /railway-staging below it.
# Leave unset for ephemeral infrastructure-only staging.
# BIOMETRIC_STAGING_DATA_DIR=/app/var

# Do not add TiDB credentials, device allowlists, production bridge credentials,
# or a production state directory. The dedicated launcher forcibly disables them.
